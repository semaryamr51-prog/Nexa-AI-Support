# App works offline without any key or LLM installation.
# Copy to .env to enable optional online language generation.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
# Enable only if Ollama is installed and the model has been pulled.
USE_OLLAMA=false
OLLAMA_MODEL=llama3.2:3b
# Optional semantic FAISS retriever (needs requirements-semantic.txt)
RAG_BACKEND=lexical
